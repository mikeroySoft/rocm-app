# Build output
/dist
/node_modules
/src-tauri/target
# Regenerated by tauri-build on every compile.
/src-tauri/gen/schemas

# Supergoal / planning / scratch artifacts never belong in the product repo.
/.supergoal/
/plans/
/workspace/
active-implementation-log.md
current-user-asks.md

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
!/tests/fixtures/**/*.pem
!/tests/fixtures/**/*.key

# Test / tooling output
/test-results/
/screenshots/
/coverage/
*.log

# Editor / OS
/.idea
/.vscode
/.claude
.DS_Store
__pycache__/

# Staged CLI payload and its compatibility manifest are build outputs: 48 MB of
# binaries copied from a rocm-cli build, described by hashes that are only true
# for that build. `scripts/stage_cli.py` regenerates both.
/src-tauri/binaries/
/src-tauri/compatibility.json
